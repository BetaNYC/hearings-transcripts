{
 "_comment": "Speaker groups and text rules for scripts/build_wordclouds.py. Reusable across hearings: edit groups to match the new hearing's speakers.csv categories.",
 "method": {
  "max_ngram": 3,
  "min_group_count": 3,
  "z_threshold": 1.96,
  "prior_scale": 0.01,
  "subsume_ratio": 0.8,
  "skip_tokens_in_any_gram": [
   "york",
   "yorkers"
  ],
  "skip_exact_grams": [
   "city",
   "act",
   "third",
   "parties",
   "party"
  ],
  "short_tokens_allowed": [
   "ai",
   "us"
  ],
  "name_tokens_not_stopped": [
   "ai",
   "new",
   "york",
   "city",
   "data"
  ],
  "join_terms": {
   "super intelligent": "superintelligent",
   "super intelligence": "superintelligence",
   "kill switches": "killswitch",
   "kill switch": "killswitch",
   "open weight": "openweight",
   "affected parties": "affectedparties"
  }
 },
 "people_method": {
  "min_person_count": 2,
  "brief_threshold": 10,
  "_comment": "Each person is compared with every other speaker at the hearing, including the rest of their own group.",
  "intro": "Individual pages are for the two invited panels: the four AI company representatives and the three former AI-company employees on the whistleblower panel."
 },
 "display": {
  "cloud_phrases": 45,
  "bar_phrases": 20,
  "highlighted_phrases": 12,
  "gallery_phrases": 8
 },
 "groups": [
  {
   "slug": "whistleblower-panel",
   "nav": "Whistleblower panel",
   "who": "the whistleblower panel",
   "note": "",
   "match": {
    "role_contains": "whistleblower panel"
   }
  },
  {
   "slug": "ai-companies",
   "nav": "AI companies",
   "who": "the AI companies",
   "note": "OpenAI, Anthropic, Meta, Google",
   "match": {
    "category": "ai-company"
   }
  },
  {
   "slug": "city-officials",
   "nav": "City officials",
   "who": "the City officials",
   "note": "",
   "match": {
    "category": "city-official"
   }
  },
  {
   "slug": "council-members",
   "nav": "Council Members",
   "who": "Council Members",
   "note": "Not counting the two chairs, Speaker Menin and Chair De La Rosa, who mostly ran the hearing",
   "match": {
    "category": "council",
    "exclude_names": [
     "Julie Menin",
     "Carmen De La Rosa"
    ]
   }
  },
  {
   "slug": "public-witnesses",
   "nav": "Public witnesses",
   "who": "the public witnesses",
   "note": "Advocates, experts, businesses and residents; not the whistleblower panel",
   "match": {
    "category": "witness",
    "exclude_role_contains": [
     "whistleblower panel"
    ]
   },
   "disclosure": "BetaNYC, which built these pages, testified at this hearing and is counted among the public witnesses."
  },
  {
   "slug": "other-electeds",
   "nav": "Other electeds",
   "who": "state and other elected officials",
   "note": "",
   "match": {
    "category": "state-or-other-elected"
   }
  }
 ],
